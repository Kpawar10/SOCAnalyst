# LLM
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Postgres / pgvector (long-term memory)
DATABASE_URL=postgresql://soc:soc_dev_password@localhost:5432/soc_memory

# Redis (cache + short-term dedupe)
REDIS_URL=redis://localhost:6379/0

# Threat intel (mocked by default; set USE_MOCK_THREAT_INTEL=false to call a real API)
THREAT_INTEL_API_KEY=changeme
USE_MOCK_THREAT_INTEL=true

# SIEM (mocked by default)
SIEM_API_URL=https://siem.example.internal/api
SIEM_API_KEY=changeme
USE_MOCK_SIEM=true

# Guardrails
EXECUTE_REMEDIATIONS=false   # NEVER set true without a real execution backend + audit trail
OFFICE_CIDR_ALLOWLIST=10.0.0.0/8,192.168.0.0/16

# App
LOG_LEVEL=INFO
APP_ENV=local
